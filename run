#!/usr/bin/env bash
# Code Ocean entry point: regenerates every figure and number of the manuscript.
# Runtime is about 60 s on a single core; there is no random number generation,
# so the output is bit-for-bit identical on every run.
set -e
cd "$(dirname "$0")"
OUT="${CO_RESULTS_FOLDER:-results}"
mkdir -p "$OUT"

echo "== Validation against the measured device population of [1] =="
python3 run_validation.py          # Figs. 4, 6, 7 + validation.json + TABLE I

echo "== Remaining figures =="
python3 run_repro.py               # Figs. 3, 5
python3 run_extensions.py          # Figs. 8, 9
python3 run_fe2d.py                # Fig. 10
python3 run_fieldmaps.py           # Figs. 2, 11
python3 run_graphical_abstract.py  # graphical abstract

mv -f *.png "$OUT"/ 2>/dev/null || true
cp -f validation.json "$OUT"/ 2>/dev/null || true
echo "== Done: see $OUT =="
